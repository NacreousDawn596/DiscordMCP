# ============================================================================
# Discord Agent — environment configuration
# Copy this file to `.env` and fill in the values.
# ============================================================================

# --- Discord ---------------------------------------------------------------
# Required. Bot token from the Discord Developer Portal (never a user token).
DISCORD_BOT_TOKEN=

# Optional. Application ID (used to register slash commands).
DISCORD_APPLICATION_ID=

# --- LLM provider ----------------------------------------------------------
# One of: openai | anthropic | gemini | openrouter | ollama | deepseek | custom
LLM_PROVIDER=openai

# API key for the chosen provider (not required for ollama).
LLM_API_KEY=

# Model name, or a comma-separated list of models to try in order. When a model
# fails or hits its quota, the next one is used; every new request starts from
# the first model. All models share the same provider/key/base URL.
#   openai:     gpt-4o-mini
#   anthropic:  claude-3-5-sonnet-latest
#   gemini:     gemini-3.1-flash-lite
#   openrouter: <any model id>
#   deepseek:   deepseek-v4-flash
#   ollama:     llama3.1
LLM_MODEL=gpt-4o-mini

# Optional. Override the API base URL (used automatically for openrouter,
# deepseek, and ollama; set explicitly for a self-hosted/proxy endpoint).
LLM_BASE_URL=

# Optional. Temperature (0.0–2.0) and max output tokens.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# --- Agent behavior --------------------------------------------------------
# Name the agent answers to (also the slash-command personality name).
AGENT_NAME=Agent

# professional | friendly | technical | minimal | funny | custom
AGENT_PERSONALITY=professional

# normal | planning | admin | moderation | analysis
AGENT_DEFAULT_MODE=normal

# Confirmation threshold. Operations at or above this risk require approval:
#   NEVER | LOW | MEDIUM | HIGH | DESTRUCTIVE | ALWAYS
AGENT_CONFIRMATION_LEVEL=HIGH

# Max LLM tool-calling iterations per request.
AGENT_MAX_ITERATIONS=15

# If true, mutating requests default to plan/preview mode.
AGENT_DRY_RUN_DEFAULT=false

# --- Database --------------------------------------------------------------
DATABASE_PATH=./data/agent.sqlite

# --- Observability ---------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- Feature toggles -------------------------------------------------------
ENABLE_MODERATION=false
ENABLE_AUTOMATIONS=true
ENABLE_SCHEDULER=true
ENABLE_SLASH_COMMANDS=false

# --- Trust / limits --------------------------------------------------------
# Comma-separated user IDs that bypass guild-level authorization (owners of the
# bot, e.g. "123456789,987654321"). Discord permission checks still apply.
# NOTE: user 778627103578783776 is always trusted (BUILT_IN_TRUSTED_USER_IDS).
ALLOWED_USER_IDS=

MESSAGE_RETENTION_DAYS=30
RATE_LIMIT_MAX_CONCURRENT=5
CACHE_TTL_SECONDS=300
CONTEXT_HISTORY_LIMIT=50

# Economy / XP (notebook-based). XP_PER_MESSAGE=0 disables passive XP.
XP_PER_MESSAGE=0
XP_COOLDOWN_SECONDS=60

# Optional. Default guild for MCP tool calls when no guild_id is supplied.
MCP_DEFAULT_GUILD_ID=
